# Voice AI Platform Environment Variables

# Application
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=false
ENVIRONMENT=production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voiceai

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Voice Providers
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Encryption (32 bytes key)
ENCRYPTION_KEY=your-32-byte-encryption-key-here
